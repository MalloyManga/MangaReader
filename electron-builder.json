{
  "appId": "com.malloy.mangareader",
  "productName": "MangaReader",
  "electronLanguages": [
    "zh-CN",
    "zh-TW",
    "en-US",
    "ja"
  ],
  "directories": {
    "output": "dist_electron"
  },
  "files": [
    "electron/**/*",
    "package.json",
    ".output/public/**/*",
    "!node_modules/pdfjs-dist/**/*",
    "!node_modules/@napi-rs/canvas/**/*",
    "!node_modules/@napi-rs/canvas-win32-x64-msvc/**/*"
  ],
  "extraResources": [
    {
      "from": "dist/backend",
      "to": "backend"
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "zip",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "public/MangaReaderLogo.ico"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "MangaReader",
    "deleteAppDataOnUninstall": true
  }
}
